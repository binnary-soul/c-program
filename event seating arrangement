#include<stdio.h>
int main()
{
    int n,i;
    unsigned long long fact=1;
    printf("enter the number of student:");
    scanf("%d",&n);
    if(n<0)
    {
        printf("invalid input");
    }
    else
    {
        for(i=1;i<=n;i++)
        {
            fact=fact*i;
            
        }
        printf("total seating arrangement=%llu",fact);
        
    }
    
    return 0;
        
        }
    
    
    
    
